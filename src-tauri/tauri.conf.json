{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KurumiDeploy",
  "version": "0.1.0",
  "identifier": "cn.kurumi.deploy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "部署工具",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "胡桃",
    "copyright": "Copyright © 胡桃",
    "category": "DeveloperTool",
    "shortDescription": "胡桃部署运维工具",
    "longDescription": "SSH 隧道、后端/前端/Docker 部署、终端与 SFTP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "胡桃"
      }
    }
  }
}
